{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cairn 配置",
  "description": "由声明自动生成，勿手改。",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "storage.block.max_bytes": {
      "type": "integer",
      "description": "单个块的字节上限，超过即分片（分片 + 索引块）",
      "default": 1048576,
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    },
    "storage.pack.max_bytes": {
      "type": "integer",
      "description": "单个载体的字节上限，写满即封口（只管封口线，不定槽长）",
      "default": 2147483648,
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    },
    "storage.pack.slot_bytes": {
      "type": "integer",
      "description": "槽长：载体内的定长分配与定位单位，建载体时写进文件头",
      "default": 65536,
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    }
  },
  "additionalProperties": true
}
