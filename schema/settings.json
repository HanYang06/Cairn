{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HanYang06/cairn/schema/settings.json",
  "title": "Cairn 配置（总词表）",
  "description": "由声明自动生成，勿手改：改配置请改 config/ 下对应的值文件。",
  "type": "object",
  "properties": {
    "core.log.level": {
      "type": "string",
      "description": "内核日志级别",
      "default": "WARNING",
      "x-cairn-owner": "core.conf.params.CoreConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    },
    "storage.block.max_bytes": {
      "type": "integer",
      "description": "单个块的字节上限，超过即分片（分片 + 索引块）",
      "default": 1048576,
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    },
    "storage.db.tables": {
      "type": "string",
      "description": "索引库表声明所在文件（**结构本体在那**；值写相对本文件的引用名，默认同层级同名）",
      "default": "tables.yaml",
      "x-cairn-file-type": "yaml",
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": false,
      "x-cairn-empty-ok": false
    },
    "storage.pack.max_bytes": {
      "type": "integer",
      "description": "单个载体的字节上限，写满即封口（只管封口线，不定槽长）",
      "default": 2147483648,
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    },
    "storage.pack.slot_bytes": {
      "type": "integer",
      "description": "槽长：载体内的定长分配与定位单位，建载体时写进文件头",
      "default": 65536,
      "x-cairn-owner": "core.storage.conf.StorageConf",
      "x-cairn-fillable": true,
      "x-cairn-empty-ok": false
    }
  },
  "additionalProperties": false
}
