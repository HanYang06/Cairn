{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HanYang06/cairn/config/schema/settings.json",
  "title": "Cairn 配置（总词表）",
  "description": "由声明自动生成，勿手改：改配置请改声明的那个 conf(...) 调用点，改值请改 config/settings.json。",
  "type": "object",
  "properties": {
    "core.log.level": {
      "type": "string",
      "description": "内核日志级别：导入内核时设到 core.* 这族记录器",
      "default": "WARNING",
      "x-cairn-owner": "core.conf.params",
      "x-cairn-site": "py_src/core/conf/params.py:16"
    },
    "hub.default": {
      "type": "string",
      "description": "默认 hub 名：写入不点名时进这一个",
      "default": "main",
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:87"
    },
    "index.max.byte": {
      "type": "integer",
      "description": "一个索引块的体积上限（字节）：写到这个数由引擎自动续下一块",
      "default": 67108864,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:88"
    },
    "pack.max.byte": {
      "type": "integer",
      "description": "封口线（字节）：单个载体写满这个数就换新的一份；只管换文件，不是硬上限",
      "default": 2147483648,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:81"
    },
    "slot.max.byte.b": {
      "type": "integer",
      "description": "格长档位之一：每单位 1 字节；五档相加即为格长，全不写则不成立",
      "default": 512,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:62"
    },
    "slot.max.byte.gb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1073741824 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:62"
    },
    "slot.max.byte.kb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1024 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:62"
    },
    "slot.max.byte.mb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1048576 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:62"
    },
    "slot.max.byte.tb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1099511627776 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:62"
    }
  }
}
