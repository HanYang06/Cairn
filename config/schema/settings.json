{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HanYang06/cairn/config/schema/settings.json",
  "title": "Cairn 配置（总词表）",
  "description": "由声明自动生成，勿手改：改配置请改声明的那个 conf(...) 调用点，改值请改 config/settings.json。",
  "type": "object",
  "properties": {
    "core.log.level": {
      "type": "string",
      "description": "内核日志级别：导入内核时设到 core.* 这族记录器",
      "default": "WARNING",
      "x-cairn-owner": "core.conf.params",
      "x-cairn-site": "py_src/core/conf/params.py:16"
    },
    "storage.block.max_bytes": {
      "type": "integer",
      "description": "单个块的字节上限，超过即分片（预留，尚未接线）",
      "default": 1048576,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:39"
    },
    "storage.pack.max_bytes": {
      "type": "integer",
      "description": "单个载体的字节上限，写满即封口（只管封口线，不定槽长）",
      "default": 2147483648,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:33"
    },
    "storage.pack.slot_bytes": {
      "type": "integer",
      "description": "槽长：载体内的定长分配与定位单位，写进文件头",
      "default": 512,
      "x-cairn-owner": "core.storage.conf",
      "x-cairn-site": "py_src/core/storage/conf.py:32"
    },
    "slot.max.byte.b": {
      "type": "integer",
      "description": "格长档位之一：每单位 1 字节；五档相加即为格长，全不写则不成立",
      "default": 512,
      "x-cairn-owner": "core.storage.slot",
      "x-cairn-site": "py_src/core/storage/slot.py:73"
    },
    "slot.max.byte.gb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1073741824 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.slot",
      "x-cairn-site": "py_src/core/storage/slot.py:73"
    },
    "slot.max.byte.kb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1024 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.slot",
      "x-cairn-site": "py_src/core/storage/slot.py:73"
    },
    "slot.max.byte.mb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1048576 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.slot",
      "x-cairn-site": "py_src/core/storage/slot.py:73"
    },
    "slot.max.byte.tb": {
      "type": "integer",
      "description": "格长档位之一：每单位 1099511627776 字节；五档相加即为格长，全不写则不成立",
      "default": 0,
      "x-cairn-owner": "core.storage.slot",
      "x-cairn-site": "py_src/core/storage/slot.py:73"
    }
  }
}
