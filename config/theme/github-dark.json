{
  "$schema": "../schema/theme.json",
  "name": "github-dark",
  "dark": true,
  "token": {
    "bg": "#0F1115",
    "chrome": "#010409",
    "surface": "#161A21",
    "elevated": "#1D222B",
    "glass": "rgba(23, 27, 34, 0.86)",
    "border": "#2A313C",
    "border_soft": "#20252E",
    "border_strong": "#484F58",
    "border_faint": "#21262D",
    "text": "#E8ECF2",
    "muted": "#98A1AD",
    "faint": "#69727E",
    "accent": "#6C9BFF",
    "accent_soft": "#232C3F",
    "accent_alt": "#5FBF8F",
    "accent_text": "#FFFFFF",
    "ochre": "#E0A458",
    "green": "#5FBF8F",
    "selection": "#26303F",
    "hover": "#222833",
    "danger": "#E06C75",
    "radius": "12px",
    "radius_lg": "16px",
    "radius_sm": "8px",
    "shadow_color": "#000000",
    "shadow_alpha": "110"
  },
  "style": {
    "widget.shell": { "background": "token.bg" },
    "widget.surface": {
      "background": "token.glass",
      "border_width": "1px",
      "border_style": "solid",
      "border_color": "token.border_soft",
      "border_radius": "token.radius_lg"
    },
    "widget.heading": { "color": "token.text", "font_size": "15px", "font_weight": "700" },
    "widget.label": { "color": "token.muted", "font_size": "12px" },
    "widget.field": {
      "background": "token.elevated",
      "color": "token.text",
      "border_width": "1px",
      "border_style": "solid",
      "border_color": "token.border",
      "border_radius": "token.radius",
      "padding": "7px 12px"
    },
    "widget.field:focus": { "border_color": "token.accent" },
    "widget.button": {
      "background": "transparent",
      "color": "token.muted",
      "border_radius": "token.radius_sm",
      "padding": "7px 10px"
    },
    "widget.button:hover": { "background": "token.hover", "color": "token.text" },
    "widget.button:checked": { "background": "token.accent_soft", "color": "token.accent" },
    "widget.stage": { "background": "token.bg", "color": "token.text" }
  }
}
